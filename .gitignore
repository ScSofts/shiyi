# 依赖
node_modules/
.pnpm-store/

# 锁文件不提交（大家用的包管理器可能不同，避免互相覆盖）
pnpm-lock.yaml
package-lock.json
yarn.lock

# 构建产物
dist/
build/
*.tsbuildinfo

# 运行时数据（照片和数据库不进仓库）
data/
!data/.gitkeep

# 环境变量：api/.env 是开发用的默认配置，故意提交；
# 下面这些是个人覆盖文件，不进仓库
.env.local
*.env.local
.env.production
*.secret

# Python
__pycache__/
*.py[cod]
.venv/
venv/
ai/models/
ai/data/

# 日志与临时文件
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json